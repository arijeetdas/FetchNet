#!/bin/sh
# FetchNet pre-commit hook: keeps the changelog in step with the version.
#
# Enabled with:  git config core.hooksPath .githooks
#
# - The commit changes the `version:` line of pubspec.yaml: the notes under
#   "## Unreleased" in CHANGELOG.md are filed under the new version (commit
#   subjects since the last bump when there are none). Then the website's
#   src/config/changelog.json is regenerated (the app reads its What's new
#   notes from the website; it ships no changelog).
# - The commit touches CHANGELOG.md: the website's JSON is regenerated.
# Anything else commits untouched.

staged=$(git diff --cached --name-only)
case "$staged" in
  *pubspec.yaml*|*CHANGELOG.md*) ;;
  *) exit 0 ;;
esac

old=$(git show HEAD:pubspec.yaml 2>/dev/null | sed -n 's/^version:[[:space:]]*//p' | tr -d '\r')
new=$(git show :pubspec.yaml 2>/dev/null | sed -n 's/^version:[[:space:]]*//p' | tr -d '\r')

if [ -n "$new" ] && [ "$old" != "$new" ]; then
  echo "changelog: version $old -> $new"
  dart run tool/changelog.dart release --version "$new" || exit 1
else
  dart run tool/changelog.dart sync || exit 1
fi

git add CHANGELOG.md
